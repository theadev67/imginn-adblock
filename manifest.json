{
  "manifest_version": 3,
  "name": "Imginn AdBlock",
  "version": "1.0.0",
  "description": "Ad Block for Imginn.",
  "content_scripts": [
    {
      "matches": ["https://imginn.com/*", "https://*.imginn.com/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
